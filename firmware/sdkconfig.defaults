# Build settings for the Waveshare ESP32-S3-Touch-LCD-4.3.
# Board part taken from Waveshare's examples/ESP-IDF/09_lvgl_v9_demo/sdkconfig.defaults
# (github.com/waveshareteam/ESP32-S3-Touch-LCD-4.3), without its LVGL demos and extra
# Montserrat fonts. The Big Six additions follow, from ../sdkconfig.defaults.append.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Flash: 16 MB, QIO at 120 MHz (needs the experimental-features switch)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_BOOTLOADER_FLASH_DC_AWARE=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_SPI_FLASH_HPM_ENA=y

# Octal PSRAM at 120 MHz, code and read-only data run from PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_TIMING_MEASURE_TEMPERATURE_INTERVAL_SECOND=5
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64

CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y

# Partition table with a 4 MB app slot
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
